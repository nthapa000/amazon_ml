# fin5 = blend(fin3 + ceq, fin4 + ceq), then fin6 = fin5 with ceqf (French-adapted ceq) patched into the unseen-country test pairs.
# ceqf itself is the GPU job from jobs/bw_retry.sh (fz_ceqf, gpu2bw.sbatch). usage: DAG_MAXJ=4 python3 jobs/dag.py jobs/fin56.dag logs/dag_fin56.log
w5 |    | sbatch --parsable -J fz_w5 --dependency=afterok:41397 --kill-on-invalid-dep=yes -c 1 --mem=1G -t 00:05:00 -o /scratch/m25csa019/logs/%x_%j.out --wrap "true"
f5 | w5 | sbatch --parsable -J fz_f5 --export=ALL,ER_WORK=/scratch/m25csa019/er_final,CMDS_A="src/train.py split=tsim tr=f_cand_tsim_ka te=f_cand_test_ka sub=oof_b1ka:pte_b1ka:0.001 frac=1.0 lr=0.05 seed=1 rounds=4000 pfile=params_fin.json extra=xf_tsim_ka+f2_tsim_ka+sib_tsim_ka+annf_tsim_ka+ctx_b1ka_train+cev_a1_train+sup_ka_tsim+cem_b1ka_train+ceb_b1ka_train+cer2_b1ka_train+ceq_b1ka_train:xf_test_ka+f2_test_ka+sib_test_ka+annf_test_ka+ctx_b1ka_test+cev_a1_test+sup_ka_test+cem_b1ka_test+ceb_b1ka_test+cer2_b1ka_test+ceq_b1ka_test tag=fin5a;src/decide.py tune tag=fin5a split=tsim",CMDS_B="src/train.py split=tsim tr=f_cand_tsim_ka te=f_cand_test_ka sub=oof_b1ka:pte_b1ka:0.001 frac=1.0 lr=0.05 seed=1 rounds=4000 pfile=params_fin.json extra=xf_tsim_ka+f2_tsim_ka+sib_tsim_ka+annf_tsim_ka+ctx_b1ka_train+cev_a1_train+sup_ka_tsim+cem_b1ka_train+cef_b1ka_train+cer2_b1ka_train+ceq_b1ka_train:xf_test_ka+f2_test_ka+sib_test_ka+annf_test_ka+ctx_b1ka_test+cev_a1_test+sup_ka_test+cem_b1ka_test+cef_b1ka_test+cer2_b1ka_test+ceq_b1ka_test tag=fin5b;src/decide.py tune tag=fin5b split=tsim",CMDS="src/blend.py tags=fin5a+fin5b out=fin5 margin=0.3 grid=1;src/decide.py tune tag=fin5 split=tsim;ana/cmp_folds.py a=b34 b=fin5 skip=0;src/cands.py s1=b1ka fin=fin5 thr=0.005 out=fin5c;src/decide.py tune tag=fin5c split=tsim;src/decide.py apply tag=fin5c out=/scratch/m25csa019/er_out/fin5c cand=cand_test_final;/csehome/m25csa019/amazon_ml/student_resource/utils/validate_submission.py --matching /scratch/m25csa019/er_out/fin5c/matching_results.tsv --candidate /scratch/m25csa019/er_out/fin5c/candidate_pairs.tsv --test-dir /csehome/m25csa019/amazon_ml/student_resource/dataset/test;src/snap.py tag=fin5c desc='blend fin3+ceq / fin4+ceq (logit) + final candidate set p1 >= 0.005';src/decide.py apply tag=fin5c out=/scratch/m25csa019/er_out/fin5c_frm2 cand=cand_test_final fr=-2;/csehome/m25csa019/amazon_ml/student_resource/utils/validate_submission.py --matching /scratch/m25csa019/er_out/fin5c_frm2/matching_results.tsv --candidate /scratch/m25csa019/er_out/fin5c_frm2/candidate_pairs.tsv --test-dir /csehome/m25csa019/amazon_ml/student_resource/dataset/test;src/snap.py tag=fin5c_frm2 desc='fin5c + fr=-2 (unseen-country shift)'" jobs/par.sbatch
w6 | f5 | sbatch --parsable -J fz_w6 -c 1 --mem=1G -t 08:00:00 -o /scratch/m25csa019/logs/%x_%j.out --wrap 'until [ -f /scratch/m25csa019/er_final/ceqf_b1ka_test.parquet ] && [ -z "$(squeue -u $USER -h -n fz_ceqf)" ]; do sleep 60; done'
f6 | w6 | sbatch --parsable -J fz_f6 -c 16 --mem=80G -t 02:00:00 --export=ALL,ER_WORK=/scratch/m25csa019/er_final,CMDS="src/train.py split=tsim te=f_cand_test_ka sub=oof_b1ka:pte_b1ka:0.001 extra=x:xf_test_ka+f2_test_ka+sib_test_ka+annf_test_ka+ctx_b1ka_test+cev_a1_test+sup_ka_test+cem_b1ka_test+ceb_b1ka_test+cer2_b1ka_test+ceqf_b1ka_test alias=ceqf:ceq models=fin5a tag=fin6a;src/train.py split=tsim te=f_cand_test_ka sub=oof_b1ka:pte_b1ka:0.001 extra=x:xf_test_ka+f2_test_ka+sib_test_ka+annf_test_ka+ctx_b1ka_test+cev_a1_test+sup_ka_test+cem_b1ka_test+cef_b1ka_test+cer2_b1ka_test+ceqf_b1ka_test alias=ceqf:ceq models=fin5b tag=fin6b;src/blend.py tags=fin6a+fin6b out=fin6 margin=0.3 grid=1;src/decide.py tune tag=fin6 split=tsim;src/cands.py s1=b1ka fin=fin6 thr=0.005 out=fin6c;src/decide.py tune tag=fin6c split=tsim;src/decide.py apply tag=fin6c out=/scratch/m25csa019/er_out/fin6c cand=cand_test_final;/csehome/m25csa019/amazon_ml/student_resource/utils/validate_submission.py --matching /scratch/m25csa019/er_out/fin6c/matching_results.tsv --candidate /scratch/m25csa019/er_out/fin6c/candidate_pairs.tsv --test-dir /csehome/m25csa019/amazon_ml/student_resource/dataset/test;src/snap.py tag=fin6c desc='fin5 with ceqf (French-adapted ceq) on unseen-country test pairs + final candidate set p1 >= 0.005';src/decide.py apply tag=fin6c out=/scratch/m25csa019/er_out/fin6c_frm2 cand=cand_test_final fr=-2;/csehome/m25csa019/amazon_ml/student_resource/utils/validate_submission.py --matching /scratch/m25csa019/er_out/fin6c_frm2/matching_results.tsv --candidate /scratch/m25csa019/er_out/fin6c_frm2/candidate_pairs.tsv --test-dir /csehome/m25csa019/amazon_ml/student_resource/dataset/test;src/snap.py tag=fin6c_frm2 desc='fin6c + fr=-2 (unseen-country shift)';ana/diff_country.py a=/scratch/m25csa019/er_out/fin5c_frm2 b=/scratch/m25csa019/er_out/fin6c_frm2" jobs/multi.sbatch
