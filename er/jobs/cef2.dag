# L1 as two 1-GPU jobs (00:25): the 2-GPU job needed ~230 GB on one node (MaxRSS ~115 GB per half); none free.
# erbw env (torch 2.7.1+cu128) runs on A30 / A6000 / Blackwell. usage: python3 jobs/dag.py jobs/cef2.dag logs/dag_cef2.log
h0  |       | sbatch --parsable -J fz_cefh0 --mem=125G -t 04:00:00 --export=ALL,ER_WORK=/scratch/m25csa019/er_final,PY=/scratch/m25csa019/envs/erbw/bin/python,ARGS="src/ce.py split=tsim tag=b1ka lo=0.003 hi=0.997 epochs=1 txt=raw model=BAAI/bge-reranker-base init=ceb_b1ka extra=fra_b1ka lr=1e-5 bs=128 pbs=512 ntr=600000 name=cef half=0" jobs/gpu.sbatch
h1  |       | sbatch --parsable -J fz_cefh1 --mem=125G -t 04:00:00 --export=ALL,ER_WORK=/scratch/m25csa019/er_final,PY=/scratch/m25csa019/envs/erbw/bin/python,ARGS="src/ce.py split=tsim tag=b1ka lo=0.003 hi=0.997 epochs=1 txt=raw model=BAAI/bge-reranker-base init=ceb_b1ka extra=fra_b1ka lr=1e-5 bs=128 pbs=512 ntr=600000 name=cef half=1" jobs/gpu.sbatch
mg  | h0 h1 | sbatch --parsable -J fz_cefmg -c 4 --mem=64G -t 01:00:00 --export=ALL,ER_WORK=/scratch/m25csa019/er_final,PY=/scratch/m25csa019/envs/erbw/bin/python,CMDS="src/ce.py merge=1 name=cef tag=b1ka" jobs/multi.sbatch
