# fin4 (27 Sep 01:00) = fin3 with cef (French self-trained ceb) instead of ceb; then fold check vs fin3.
# usage: DAG_MAXJ=2 python3 jobs/dag.py jobs/fin4.dag logs/dag_fin4.log  (started after cef is merged, see jobs/cef2.dag)
f4  |    | sbatch --parsable -J fz_f4 -t 04:00:00 --mem=64G --export=ALL,ER_WORK=/scratch/m25csa019/er_final,CMDS="src/train.py split=tsim tr=f_cand_tsim_ka te=f_cand_test_ka sub=oof_b1ka:pte_b1ka:0.001 frac=1.0 lr=0.05 seed=1 rounds=4000 extra=xf_tsim_ka+f2_tsim_ka+sib_tsim_ka+annf_tsim_ka+ctx_b1ka_train+cev_a1_train+sup_ka_tsim+cem_b1ka_train+cef_b1ka_train+cer2_b1ka_train:xf_test_ka+f2_test_ka+sib_test_ka+annf_test_ka+ctx_b1ka_test+cev_a1_test+sup_ka_test+cem_b1ka_test+cef_b1ka_test+cer2_b1ka_test tag=fin4 pfile=params_fin.json;src/decide.py tune tag=fin4 split=tsim" jobs/multi.sbatch
cmp | f4 | sbatch --parsable -J fz_cmp34 -c 8 --mem=64G -t 00:30:00 --export=ALL,ER_WORK=/scratch/m25csa019/er_final,ARGS="ana/cmp_folds.py a=fin3 b=fin4 skip=0" jobs/py.sbatch
