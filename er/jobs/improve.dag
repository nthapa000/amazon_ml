# Improvement round (2026-09-26): Optuna on stage 2 + 4th cross-encoder bge-reranker-v2-m3 (cer). Reuses er_final; only fin retrains.
# usage: python3 jobs/dag.py jobs/improve.dag logs/dag_improve.log
opt     |          | sbatch --parsable -J fz_opt -c 24 --mem=48G -t 06:00:00 --export=ALL,ER_WORK=/scratch/m25csa019/er_final,CMDS="src/tune.py tr=f_cand_tsim_ka extra=xf_tsim_ka+f2_tsim_ka+sib_tsim_ka+annf_tsim_ka+ctx_b1ka_train+cev_a1_train+sup_ka_tsim+cem_b1ka_train+ceb_b1ka_train sub=oof_b1ka:0.001 trials=30 frac=0.4 out=fin" jobs/multi.sbatch
cesmoke |          | sbatch --parsable -J fz_cesmoke -x cn07 -t 01:00:00 --export=ALL,ER_WORK=/scratch/m25csa019/er_final,ARGS="src/ce.py split=tsim tag=b1ka lo=0.003 hi=0.997 epochs=1 txt=raw model=BAAI/bge-reranker-v2-m3 lr=2e-5 bs=64 pbs=512 save=0 lim=20000 ntr=20000 name=cersmoke" jobs/gpu.sbatch
cer     | cesmoke  | sbatch --parsable -J fz_cer -x cn07 -t 12:00:00 --export=ALL,ER_WORK=/scratch/m25csa019/er_final,ARGS="src/ce.py split=tsim tag=b1ka lo=0.003 hi=0.997 epochs=1 txt=raw model=BAAI/bge-reranker-v2-m3 lr=2e-5 bs=64 pbs=512 save=0 ntr=600000 name=cer" jobs/gpu.sbatch
f2b     | opt      | sbatch --parsable -J fz_f2b -t 04:00:00 --mem=64G --export=ALL,ER_WORK=/scratch/m25csa019/er_final,CMDS="src/train.py split=tsim tr=f_cand_tsim_ka te=f_cand_test_ka sub=oof_b1ka:pte_b1ka:0.001 frac=1.0 lr=0.05 seed=1 rounds=4000 extra=xf_tsim_ka+f2_tsim_ka+sib_tsim_ka+annf_tsim_ka+ctx_b1ka_train+cev_a1_train+sup_ka_tsim+cem_b1ka_train+ceb_b1ka_train:xf_test_ka+f2_test_ka+sib_test_ka+annf_test_ka+ctx_b1ka_test+cev_a1_test+sup_ka_test+cem_b1ka_test+ceb_b1ka_test tag=fin2b pfile=params_fin.json;src/decide.py tune tag=fin2b split=tsim" jobs/multi.sbatch
f2a     | cer      | sbatch --parsable -J fz_f2a -t 04:00:00 --mem=64G --export=ALL,ER_WORK=/scratch/m25csa019/er_final,CMDS="src/train.py split=tsim tr=f_cand_tsim_ka te=f_cand_test_ka sub=oof_b1ka:pte_b1ka:0.001 frac=1.0 lr=0.05 seed=1 rounds=4000 extra=xf_tsim_ka+f2_tsim_ka+sib_tsim_ka+annf_tsim_ka+ctx_b1ka_train+cev_a1_train+sup_ka_tsim+cem_b1ka_train+ceb_b1ka_train+cer_b1ka_train:xf_test_ka+f2_test_ka+sib_test_ka+annf_test_ka+ctx_b1ka_test+cev_a1_test+sup_ka_test+cem_b1ka_test+ceb_b1ka_test+cer_b1ka_test tag=fin2a;src/decide.py tune tag=fin2a split=tsim" jobs/multi.sbatch
f2      | opt cer  | sbatch --parsable -J fz_f2 -t 04:00:00 --mem=64G --export=ALL,ER_WORK=/scratch/m25csa019/er_final,CMDS="src/train.py split=tsim tr=f_cand_tsim_ka te=f_cand_test_ka sub=oof_b1ka:pte_b1ka:0.001 frac=1.0 lr=0.05 seed=1 rounds=4000 extra=xf_tsim_ka+f2_tsim_ka+sib_tsim_ka+annf_tsim_ka+ctx_b1ka_train+cev_a1_train+sup_ka_tsim+cem_b1ka_train+ceb_b1ka_train+cer_b1ka_train:xf_test_ka+f2_test_ka+sib_test_ka+annf_test_ka+ctx_b1ka_test+cev_a1_test+sup_ka_test+cem_b1ka_test+ceb_b1ka_test+cer_b1ka_test tag=fin2 pfile=params_fin.json;src/decide.py tune tag=fin2 split=tsim" jobs/multi.sbatch
