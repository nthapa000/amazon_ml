# cer2 (2026-09-26 21:00): bge-reranker-v2-m3 retrained on the full band recipe of ceb (~1.6M pairs per half x 2 epochs),
# halves as parallel GPU jobs, merged; fin3 = fin2 with cer2 instead of cer. cer (cer_b1ka_*) and fin2 are kept as reference.
# 22:15: moved to cn07 (RTX PRO 6000 Blackwell / A6000) with the side env /scratch/m25csa019/envs/erbw (torch 2.7.1+cu128); cn03 A30 was hardware-throttled.
# usage: python3 jobs/dag.py jobs/cer2bw.dag logs/dag_cer2.log
h0    |       | sbatch --parsable -J fz_cer2h0 -w cn07 --mem=100G -t 12:00:00 --export=ALL,ER_WORK=/scratch/m25csa019/er_final,PY=/scratch/m25csa019/envs/erbw/bin/python,ARGS="src/ce.py split=tsim tag=b1ka lo=0.003 hi=0.997 ntr=3000000 epochs=2 txt=raw model=BAAI/bge-reranker-v2-m3 lr=2e-5 bs=64 pbs=512 save=0 name=cer2 half=0" jobs/gpu.sbatch
h1    |       | sbatch --parsable -J fz_cer2h1 -w cn07 --mem=100G -t 12:00:00 --export=ALL,ER_WORK=/scratch/m25csa019/er_final,PY=/scratch/m25csa019/envs/erbw/bin/python,ARGS="src/ce.py split=tsim tag=b1ka lo=0.003 hi=0.997 ntr=3000000 epochs=2 txt=raw model=BAAI/bge-reranker-v2-m3 lr=2e-5 bs=64 pbs=512 save=0 name=cer2 half=1" jobs/gpu.sbatch
mg    | h0 h1 | sbatch --parsable -J fz_cer2mg -c 4 --mem=64G -t 01:00:00 --export=ALL,ER_WORK=/scratch/m25csa019/er_final,CMDS="src/ce.py merge=1 name=cer2 tag=b1ka" jobs/multi.sbatch
f3    | mg    | sbatch --parsable -J fz_f3 -t 04:00:00 --mem=64G --export=ALL,ER_WORK=/scratch/m25csa019/er_final,CMDS="src/train.py split=tsim tr=f_cand_tsim_ka te=f_cand_test_ka sub=oof_b1ka:pte_b1ka:0.001 frac=1.0 lr=0.05 seed=1 rounds=4000 extra=xf_tsim_ka+f2_tsim_ka+sib_tsim_ka+annf_tsim_ka+ctx_b1ka_train+cev_a1_train+sup_ka_tsim+cem_b1ka_train+ceb_b1ka_train+cer2_b1ka_train:xf_test_ka+f2_test_ka+sib_test_ka+annf_test_ka+ctx_b1ka_test+cev_a1_test+sup_ka_test+cem_b1ka_test+ceb_b1ka_test+cer2_b1ka_test tag=fin3 pfile=params_fin.json;src/decide.py tune tag=fin3 split=tsim" jobs/multi.sbatch
